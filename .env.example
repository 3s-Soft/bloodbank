# ---------------------------------------------------------------------------
# MySQL (Hostinger shared hosting)
# ---------------------------------------------------------------------------
# Use the hostname, not the bare IP: the IP can change.
# Enable access in hPanel under Databases -> Remote MySQL first.
MYSQL_HOST=srvXXX.hstgr.io
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_password

# One connection per serverless instance. Hostinger shared plans cap
# max_user_connections (50 on this account), so raising this multiplies
# connections by the number of concurrent Vercel lambdas.
MYSQL_POOL_LIMIT=1

# Alternative to the discrete variables above. If the password contains
# characters such as @ or #, they must be percent-encoded here; the discrete
# variables need no encoding, which is why they are preferred.
# DATABASE_URL=mysql://user:password@host:3306/database

# ---------------------------------------------------------------------------
# Canonical site URL
# ---------------------------------------------------------------------------
# Used for the absolute URLs in robots.txt and sitemap.xml. Falls back to
# NEXTAUTH_URL, so setting it is only necessary if the two ever differ.
# NEXT_PUBLIC_SITE_URL=https://blood.3s-soft.net

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Local: http://localhost:3000 -- in production, the deployed URL.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google sign-in (optional; the phone and email providers work without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications only -- no database use)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account, for sending notifications from the server.
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes; they are converted at load time.
FIREBASE_PRIVATE_KEY=

# Web push key used by the browser to request an FCM token.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# SMS / phone verification (optional)
# ---------------------------------------------------------------------------
# Phone verification is OFF unless this is exactly "true", so a deployment
# without an SMS gateway keeps registering donors as before.
OTP_REQUIRED=false

# Any Bangladeshi gateway that accepts a form POST works (Alpha SMS,
# BulkSMSBD, SSL Wireless, REVE...). Only the endpoint and parameter names
# differ, so no code change is needed to switch provider.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Override only if your gateway names its parameters differently.
# SMS_PARAM_KEY=api_key
# SMS_PARAM_TO=msisdn
# SMS_PARAM_MESSAGE=message
# SMS_PARAM_SENDER=sender_id

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
